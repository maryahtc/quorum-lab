# ---------------------------------------------------------------------------
# Quorum Lab · Solicitações — variáveis de ambiente
# Configure em: Netlify → Site configuration → Environment variables
# Nunca faça commit de um arquivo .env com valores reais.
# ---------------------------------------------------------------------------

# E-mail (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM="Quorum Lab <solicitacoes@SEU-DOMINIO.com.br>"
QUORUM_INBOX_EMAIL=planejamento@SEU-DOMINIO.com.br   # vários: separados por vírgula
QUORUM_REPLY_TO=                                     # opcional: "responder" da confirmação ao dentista

# Armazenamento temporário (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=quorum-solicitacoes

# Regras
ATTACHMENT_MAX_MB=15          # limite do conjunto de anexos do e-mail (antes do base64)
FILE_RETENTION_DAYS=7         # validade dos links (máx. 7) — igual à regra de ciclo de vida do R2
UPLOAD_SIGNING_SECRET=        # string aleatória com 32+ caracteres: openssl rand -hex 32

# Anti-spam (Cloudflare Turnstile) — opcional em desenvolvimento, obrigatório em produção
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
